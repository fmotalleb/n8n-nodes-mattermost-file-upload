{
    "name": "n8n-nodes-mattermost-file-upload",
    "version": "0.1.0",
    "description": "a simple node to upload file to mattermost",
    "license": "MIT",
    "homepage": "https://github.com/fmotalleb/n8n-nodes-mattermost-file-upload",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Motalleb Fallahnezhad",
        "email": "fmotalleb@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/fmotalleb/n8n-nodes-mattermost-file-upload.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [],
        "nodes": [
            "dist/nodes/Mattermost/Mattermost.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "allowScripts": {
        "cpu-features@0.0.10": true,
        "isolated-vm@7.0.1": true,
        "ssh2@1.15.0": true,
        "unrs-resolver@1.12.2": true,
        "eslint-plugin-n8n-nodes-base@1.16.7": true
    }
}
